# AgriIntel Production Secrets Template
# Copy this file to .streamlit/secrets.toml and fill in your keys
# (Note: AgriIntel operates 100% offline out-of-the-box; these are only required for Live LLM mode)

# Google Gemini API (Recommended for live multi-agent orchestration)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY = ""

# OpenAI API (Optional alternative for GPT-4o / o1)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY = ""

# Groq Cloud API (Optional fast open-source Llama 3 models)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY = ""

# NASA POWER / ISRIC SoilGrids API credentials (Optional enterprise tier)
NASA_POWER_USER = ""
